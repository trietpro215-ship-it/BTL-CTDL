// So the he = chieu cao cua cay
int chieuCao(Node* n){
    if (n == NULL) return 0;
    int hCon = 1 + chieuCao(n->firstChild);    // xuong mot the he.
    int hEm = chieuCao(n->nextSibling);        // sang em: cung the he.
    if (hCon > hEm) return hCon;
    return hEm;
}

