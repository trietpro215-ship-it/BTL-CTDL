// da, db = so doi tu A (va B) len to tien chung. In "A la ... cua B"
void inMoTaQuanHe(int da, int db) {
    if (da == 0 && db == 0) {
        cout << "cung mot nguoi";
    } else if (da == 0) {                          // A la to tien cua B
        if (db == 1) cout << "cha/me";
        else if (db == 2) cout << "ong/ba";
        else if (db == 3) cout << "cu";
        else cout << "to tien (cach " << db << " doi)";
    } else if (db == 0) {                          // A la hau due cua B
        if (da == 1) cout << "con";
        else if (da == 2) cout << "chau";
        else if (da == 3) cout << "chat";
        else cout << "hau due (cach " << da << " doi)";
    } else if (da == 1 && db == 1) {
        cout << "anh/chi/em (cung cha/me)";
    } else if (da == 1 && db == 2) {
        cout << "chu/bac/co/cau/di (anh/chi/em cua cha/me)";
    } else if (da == 2 && db == 1) {
        cout << "chau (con cua anh/chi/em)";
    } else if (da == 2 && db == 2) {
        cout << "anh/chi/em ho";
    } else {
        cout << "ho hang (A cach to tien chung " << da << " doi, B cach " << db << " doi)";
    }
}

// Chuc nang 11: tra cuu quan he ho hang giua A va B
void traCuuQuanHe() {
    if (root == NULL) {
        cout << "  ! Gia pha dang rong.\n";
        return;
    }
    Node* a = hoiThanhVien("Ma thanh vien A: ");
    if (a == NULL) return;
    Node* b = hoiThanhVien("Ma thanh vien B: ");
    if (b == NULL) return;

    Node* l = timLCA(root, a, b);                 // to tien chung gan nhat
    Node* duongA[MAX_NODE];
    Node* duongB[MAX_NODE];
    int soA = 0, soB = 0;
    timDuongDi(root, a, duongA, soA);             // duong tu goc den A
    timDuongDi(root, b, duongB, soB);             // duong tu goc den B

    int theHeL = tinhTheHe(root, l, 1);
    int da = soA - theHeL;                        // so doi tu A len L
    int db = soB - theHeL;                        // so doi tu B len L

    cout << "  " << a->name << " la ";
    inMoTaQuanHe(da, db);
    cout << " cua " << b->name << ".\n";

    cout << "  Duong quan he: ";
    int i;
    for (i = soA - 1; i >= theHeL - 1; i--) {     // tu A di len den L
        cout << duongA[i]->name;
        if (i > theHeL - 1) cout << " -> ";
    }
    for (i = theHeL; i < soB; i++) {              // tu L di xuong B
        cout << " -> " << duongB[i]->name;
    }
    cout << "\n  (To tien chung gan nhat: " << l->name << ")\n";
}




// Bac the he cua "dich" (goc = 1).
//  - di xuong con dau (firstChild): the he + 1
//  - di sang em ke tiep (nextSibling): CUNG the he
// Tra ve -1 neu khong thay.
int tinhTheHe(Node* n, Node* dich, int doSau) {
    if (n == NULL) return -1;
    if (n == dich) return doSau;
    int kq = tinhTheHe(n->firstChild, dich, doSau + 1);
    if (kq != -1) return kq;
    return tinhTheHe(n->nextSibling, dich, doSau);   // em: khong tang the he
}

// DFS tien thu tu: tham nut -> tham con -> tham em
