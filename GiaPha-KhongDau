// BFS: dung hang doi lam bang mang (dau = vi tri lay ra, cuoi = vi tri them vao)
void menuBFS() {
    if (root == NULL) {
        cout << "  ! Gia pha dang rong.\n";
        return;
    }
    cout << "--- Duyet BFS (theo the he) ---\n";
    Node* hang[MAX_NODE];        // hang doi cac nut
    int mucNut[MAX_NODE];        // the he cua tung nut trong hang doi
    int dau = 0, cuoi = 0;
    hang[cuoi] = root;
    mucNut[cuoi] = 1;
    cuoi++;
    int mucHienTai = 0;
    while (dau < cuoi) {
        Node* n = hang[dau];     // lay phan tu dau hang doi
        int muc = mucNut[dau];
        dau++;
        if (muc != mucHienTai) { // sang the he moi thi xuong dong
            if (mucHienTai != 0) cout << "\n";
            cout << "The he " << muc << ": ";
            mucHienTai = muc;
        }
        cout << n->name << " [" << n->id << "]   ";
        // day tat ca CON cua n vao hang doi (con dau roi cac em cua con dau)
        for (Node* c = n->firstChild; c != NULL; c = c->nextSibling) {
            hang[cuoi] = c;
            mucNut[cuoi] = muc + 1;
            cuoi++;
        }
    }
    cout << "\n";
}

// LCA: to tien chung gan nhat cua a va b (ca hai phai co trong cay).
// Neu a la to tien cua b thi ket qua la a.
Node* timLCA(Node* goc, Node* a, Node* b) {
    if (goc == NULL) return NULL;
    if (goc == a || goc == b) return goc;
    Node* ketQua = NULL;
    int soNhanhThay = 0;
    for (Node* c = goc->firstChild; c != NULL; c = c->nextSibling) {  // chi xet CON cua goc
        Node* x = timLCA(c, a, b);
        if (x != NULL) {
            soNhanhThay++;
            ketQua = x;
        }
    }
    if (soNhanhThay >= 2) return goc;    // a, b nam o hai nhanh con khac nhau
    return ketQua;
}

// Tim duong di tu n xuong "dich", ghi vao mang duong (de quy quay lui)
bool timDuongDi(Node* n, Node* dich, Node* duong[], int& soLuong) {
    duong[soLuong] = n;
    soLuong++;
    if (n == dich) return true;
    for (Node* c = n->firstChild; c != NULL; c = c->nextSibling) {
        if (timDuongDi(c, dich, duong, soLuong)) return true;
    }
    soLuong--;                           // khong dung huong: bo n ra khoi duong di
    return false;
}

